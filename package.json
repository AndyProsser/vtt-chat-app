{
  "name": "vtt-chat-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Voice + chat overlay for D&D Beyond Maps VTT — Tauri desktop client, Rust LiveKit, native Ubuntu backend.",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "backend",
    "ddb",
    "ai",
    "status",
    "shared",
    "tauri-client/overlay-ui"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "node scripts/dev.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
