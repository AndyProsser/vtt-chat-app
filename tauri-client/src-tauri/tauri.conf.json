{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTT Chat",
  "version": "0.4.0",
  "identifier": "app.vttchat.desktop",
  "build": {
    "frontendDist": "../panels-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vtt-chat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTNGMDc0MjU0OTg1ODkKUldTSmhVa2xkUERqVmRWUXJhazNaQ2IvQjVYQTk0UmRZNnJhUWd0QUNKcDdNWWhacmZia3YrQmsK",
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-256.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Voice, chat and session records for tabletop groups",
    "longDescription": "A small system-tray app for tabletop groups: open-mic group voice, chat and whispers, handouts and loot, and a searchable record of every session with summaries. It connects to a server your group hosts yourselves.",
    "publisher": "Andy Prosser",
    "homepage": "https://github.com/AndyProsser/vtt-chat-app",
    "license": "AGPL-3.0-only",
    "copyright": "Copyright (c) 2026 Andy Prosser",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/io.github.andyprosser.vtt-chat.metainfo.xml": "linux/io.github.andyprosser.vtt-chat.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/io.github.andyprosser.vtt-chat.metainfo.xml": "linux/io.github.andyprosser.vtt-chat.metainfo.xml"
        }
      }
    }
  }
}
