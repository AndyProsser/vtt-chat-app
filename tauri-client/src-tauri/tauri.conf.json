{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTT Chat App",
  "version": "0.2.1",
  "identifier": "app.vttchat.desktop",
  "build": {
    "frontendDist": "../panels-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vtt-chat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTNGMDc0MjU0OTg1ODkKUldTSmhVa2xkUERqVmRWUXJhazNaQ2IvQjVYQTk0UmRZNnJhUWd0QUNKcDdNWWhacmZia3YrQmsK",
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon-256.png", "icons/icon.ico"],
    "targets": "all"
  }
}
