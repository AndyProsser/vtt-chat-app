# This machine's LAN address: the only place Whisper (and Ollama) listen. Not 0.0.0.0.
AI_BIND=192.168.1.10
WHISPER_PORT=8080
# CUDA architectures to build for: 61 = GTX 10-series, 75 = RTX 20, 86 = RTX 30, 89 = RTX 40.
CUDA_ARCHS=61;75;86;89
# Whisper large-v3-turbo q5_0 is the 8 GB GPU default (about 1 GB of VRAM). The model file is fetched on first start.
WHISPER_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=en
# Only for `--profile ollama`:
OLLAMA_VERSION=0.40.17
OLLAMA_PORT=11434
