#!/usr/bin/env bash
# The operator's command.   vtt-admin <command>
#   Server commands (status, user, settings, jobs, recording, updates, ...) run inside the backend container.
#   Machine commands (below) run docker compose in this folder:
#     logs [service]   restart [service]   ps   backup [--audio]   restore <folder> --yes   update [--version x.y.z]
#     config show | config set KEY VALUE      voice-address <ip|name|auto>
# Works through a link or a launcher (the installer makes /usr/local/bin/vtt-admin) and asks for sudo when this user is not in
# the docker group.
here=$(dirname "$(readlink -f "$0")")
cd "$here" || exit 1

# .env holds the secrets (mode 600, owned by root), and docker compose reads it, so a user who can run docker but cannot read .env
# still needs sudo. `can_run` is true only when both work.
can_run() { docker info >/dev/null 2>&1 && [ -r .env ]; }
dc() {
  if can_run; then docker compose "$@"; else sudo -- docker compose "$@"; fi
}

# What the CLI in the container needs to know about this terminal: its width (for wrapping), whether
# output is a terminal at all (colour and graphics; plain when piped, as the container cannot tell),
# NO_COLOR if set, and this machine's name (inside the container it would be the container's id).
# Checked here, not inside term_env: that runs in a process substitution, where stdout is always a pipe.
if [ -t 1 ]; then out_is_tty=1; else out_is_tty=0; fi
term_env() {
  printf '%s\n' -e "COLUMNS=$(tput cols 2>/dev/null || echo 100)" -e VTT_ADMIN_HOST=compose -e "VTT_HOST_NAME=$(hostname)"
  if ((out_is_tty)); then printf '%s\n' -e FORCE_COLOR=1; else printf '%s\n' -e VTT_ADMIN_PLAIN=1; fi
  if [ -n "${NO_COLOR:-}" ]; then printf '%s\n' -e NO_COLOR=1; fi
}

case ${1:-} in
  logs)
    shift
    dc logs --tail 200 -f "${@:-backend}"
    ;;
  restart)
    shift
    dc restart "$@"
    ;;
  ps)
    dc ps
    ;;
  backup)
    shift
    if can_run; then ./backup.sh "$@"; else sudo -- ./backup.sh "$@"; fi
    ;;
  restore)
    shift
    if can_run; then ./restore.sh "$@"; else sudo -- ./restore.sh "$@"; fi
    ;;
  update)
    shift
    site=$(sed -n 's/^SITE_ADDRESS=//p' .env)
    [ -n "$site" ] || { echo "no SITE_ADDRESS in $here/.env" >&2; exit 1; }
    repo=${VTT_REPO:-AndyProsser/vtt-chat-app}
    # The installer replaces this very script. Bash reads a script as it goes, so it must stop here (exit, with the
    # installer's status) rather than carry on reading the new file from the old offset.
    curl -fsSL "https://raw.githubusercontent.com/$repo/main/infra/get.sh" | sudo bash -s -- --yes --domain "$site" "$@"
    exit "${PIPESTATUS[1]}"
    ;;
  config)
    case ${2:-show} in
      show)
        # Secrets are hidden; everything else is shown as written.
        sed -E 's/^([A-Z_]*(PASSWORD|SECRET|KEY)[A-Z_]*)=.*/\1=(hidden)/; s#(://[^:/@]*:)[^@]*@#\1(hidden)@#' .env
        ;;
      set)
        key=${3:-} val=${4:-}
        [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "usage: vtt-admin config set KEY VALUE   (KEY in capitals, e.g. RECORD_CUES)" >&2; exit 2; }
        sudo_=""; [ -w .env ] || sudo_="sudo"
        if grep -q "^$key=" .env; then
          $sudo_ sed -i "s|^$key=.*|$key=${val//|/\\|}|" .env
        else
          echo "$key=$val" | $sudo_ tee -a .env >/dev/null
        fi
        echo "$key set. Applying (this restarts what changed)..."
        dc up -d
        ;;
      *) echo "usage: vtt-admin config show | config set KEY VALUE" >&2; exit 2 ;;
    esac
    ;;
  voice-address)
    # Where players' voice (UDP) connects. The web address can sit behind Cloudflare; voice never goes through it.
    addr=${2:-}
    [ -n "$addr" ] || { echo "usage: vtt-admin voice-address <ip | dns-name | auto>   (auto: LiveKit finds its own public address)" >&2; exit 2; }
    sudo_=""; [ -w livekit.yaml ] || sudo_="sudo"
    if [ "$addr" = auto ]; then
      $sudo_ sed -i '/^  node_ip:/d; s/^  use_external_ip:.*/  use_external_ip: true/' livekit.yaml
    else
      ip=$addr
      case $addr in
        *[!0-9.]* | "") ip=$(getent ahostsv4 "$addr" | awk 'NR==1 {print $1}') ;;
      esac
      [ -n "$ip" ] || { echo "could not resolve $addr to an IPv4 address" >&2; exit 1; }
      $sudo_ sed -i "/^  node_ip:/d; s/^  use_external_ip:.*/  use_external_ip: false\n  node_ip: $ip/" livekit.yaml
    fi
    if grep -q '^VOICE_ADDRESS=' .env; then $sudo_ sed -i "s|^VOICE_ADDRESS=.*|VOICE_ADDRESS=$addr|" .env; else echo "VOICE_ADDRESS=$addr" | $sudo_ tee -a .env >/dev/null; fi
    echo "Voice will be advertised at: $(grep -E '^  (node_ip|use_external_ip)' livekit.yaml | tr -s ' ' | tr '\n' ' ')"
    echo "Restarting LiveKit (anyone on a call reconnects in a few seconds)..."
    dc restart livekit
    ;;
  test)
    # Is everything working? AI is tested in the worker's container, where Whisper's and Ollama's addresses and the API keys
    # are; voice and reach run in the backend. `test full` runs them one after another and fails if any of them does.
    mapfile -t envs < <(term_env)
    ai_test() {
      if ! dc ps --services --status running 2>/dev/null | grep -qx worker; then
        echo "the records worker is not running, so there is no AI to test (installed without --with-records? see: vtt-admin ps)" >&2
        return 1
      fi
      dc exec "${envs[@]}" worker node ai/dist/cli/selftest.js "$@"
    }
    # The router can only be asked from the host's own network (UPnP and NAT-PMP do not cross Docker's bridge), so a throwaway
    # container with the host network asks, and the answer goes to the test as VTT_ROUTER_WAN. No answer is fine: it stays unknown.
    router_wan() {
      local image
      image=$(dc images -q backend 2>/dev/null | head -n 1)
      [ -n "$image" ] || return 0
      if can_run; then
        docker run --rm --network host --entrypoint node "$image" backend/dist/cli/main.js router-address 2>/dev/null || true
      else
        sudo -- docker run --rm --network host --entrypoint node "$image" backend/dist/cli/main.js router-address 2>/dev/null || true
      fi
    }
    # Voice's UDP is proved by a listener on a free port of the media range, which also has to sit on the host's network: started
    # here for the 90 s the check takes, its port handed to the test.
    udp_echo_start() {
      local image cid
      image=$(dc images -q backend 2>/dev/null | head -n 1)
      [ -n "$image" ] || return 0
      if can_run; then
        cid=$(docker run -d --rm --network host --entrypoint node "$image" backend/dist/cli/main.js udp-echo 2>/dev/null) || return 0
        sleep 1
        docker logs "$cid" 2>/dev/null | head -n 1
      else
        cid=$(sudo -- docker run -d --rm --network host --entrypoint node "$image" backend/dist/cli/main.js udp-echo 2>/dev/null) || return 0
        sleep 1
        sudo -- docker logs "$cid" 2>/dev/null | head -n 1
      fi
      echo "$cid" >"$udp_cid_file"
    }
    udp_cid_file=$(mktemp)
    trap 'cid=$(cat "$udp_cid_file" 2>/dev/null); [ -n "$cid" ] && { docker rm -f "$cid" || sudo -- docker rm -f "$cid"; } >/dev/null 2>&1; rm -f "$udp_cid_file"' EXIT
    backend_test() {
      local wan="" port=""
      case ${1:-} in reach)
        wan=$(router_wan | head -n 1)
        port=$(udp_echo_start | head -n 1)
        ;;
      esac
      dc exec "${envs[@]}" -e "VTT_ROUTER_WAN=$wan" -e "VTT_UDP_PROBE_PORT=$port" backend node backend/dist/cli/main.js test "$@"
    }
    case ${2:-} in
      ai)
        shift 2
        ai_test "$@"
        ;;
      full)
        shift 2
        external=0
        ai_args=()
        for a in "$@"; do
          if [ "$a" = --external ]; then external=1; else ai_args+=("$a"); fi
        done
        rc=0
        ai_test "${ai_args[@]}" || rc=1
        echo
        backend_test voice || rc=1
        echo
        if ((external)); then
          backend_test reach || rc=1
        else
          echo "  Outside check skipped: add --external (it asks check-host.net, a free third-party service) or run: vtt-admin test reach"
        fi
        exit "$rc"
        ;;
      *)
        shift
        backend_test "$@"
        ;;
    esac
    ;;
  help | --help | -h)
    # One help for both kinds of command: the CLI also prints this wrapper's commands (VTT_ADMIN_HOST).
    mapfile -t envs < <(term_env)
    dc exec -T "${envs[@]}" backend node backend/dist/cli/main.js help
    ;;
  *)
    mapfile -t envs < <(term_env)
    dc exec "${envs[@]}" backend node backend/dist/cli/main.js "$@"
    ;;
esac
