{
	# Who may tell us a visitor's real address. Normally only private networks. When the site is behind Cloudflare's proxy the
	# installer sets TRUSTED_PROXIES to Cloudflare's ranges and CLIENT_IP_HEADERS to CF-Connecting-IP (see .env).
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers {$CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

# One hostname. A real domain gets a Let's Encrypt certificate automatically; `localhost` gets
# Caddy's own internal CA (fine for a local test, not trusted by other machines).
# CADDY_SITE is the site address by default. Behind a Cloudflare Tunnel (which brings the traffic in over its own encrypted
# connection and holds the certificate) the installer sets it to http://<domain>, so Caddy serves plain HTTP and asks for no certificate.
{$CADDY_SITE} {
	encode zstd gzip

	# Optional certificate settings (the installer writes tls.d/cloudflare.caddy for --cloudflare-dns); nothing here by default.
	import /etc/caddy/tls.d/*.caddy

	# Signalling for LiveKit: the SDK appends /rtc, so strip our prefix. Media (UDP) bypasses Caddy.
	handle_path /livekit/* {
		reverse_proxy host.docker.internal:7880
	}

	# REST and the WebSocket live channel; Caddy upgrades /ws transparently.
	handle {
		reverse_proxy backend:3000
	}
}
