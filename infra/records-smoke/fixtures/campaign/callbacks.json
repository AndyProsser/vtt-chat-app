{
  "about": "The links between sessions that campaign memory and the bard are tested on. `source` must match each session in `introduced` and `recurs` (the validator checks the scripts). `memory`: after this session's job, the campaign memory must hold an entry matching `pattern`. `weave`: the tale or the Chronicler's brief for `session` should connect the thing back to its first appearance, judged by `pattern` and then by reading. `trap` entries are written to be confused and must stay separate.",
  "callbacks": [
    {
      "id": "mabel",
      "what": "Mabel Thrupp, the throwaway ferrywoman paid in pickled onions (the 'find Gary' test)",
      "introduced": 1,
      "recurs": [2, 3, 4],
      "source": "Mabel Thrupp",
      "memory": {
        "after": 1,
        "pattern": "mabel"
      },
      "weave": {
        "session": 3,
        "outputs": ["tale", "brief"],
        "pattern": "mabel.{0,200}(onion|ferr|duchess)|(onion|ferr|duchess).{0,200}mabel"
      }
    },
